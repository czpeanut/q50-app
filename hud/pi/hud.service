# systemd unit for the HUD backend. Install:
#   sudo cp hud.service /etc/systemd/system/ && sudo systemctl enable --now hud
# Point --port at your adapter. /dev/serial/by-id/... survives replugging in a
# different USB socket; /dev/ttyUSB0 does not.
[Unit]
Description=V.T.D. HUD backend (OBD reader + local web server)
After=network.target

[Service]
User=pi
WorkingDirectory=/home/pi/hud
ExecStart=/usr/bin/python3 /home/pi/hud/hud.py --port /dev/ttyUSB0
Restart=always
RestartSec=3

[Install]
WantedBy=multi-user.target
